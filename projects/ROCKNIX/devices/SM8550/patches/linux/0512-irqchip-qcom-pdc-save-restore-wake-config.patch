From: seilent <github@seilent.net>
Date: Sat, 30 May 2026 00:05:00 +0900
Subject: [PATCH] irqchip/qcom-pdc: save/restore wake config across deep sleep

On a firmware-assisted deep suspend the SoC collapses the CX rail, which
clears the PDC IRQ enable / config registers. Mainline never saves or
restores them, so after resume from deep sleep the PDC no longer routes
wake interrupts to the GIC -- the device cannot be woken (power button
appears dead, only the fan spins) and is eventually reset by the
watchdog. This matches the long-standing "won't wake from deep sleep"
behaviour on SM8550.

Add syscore_ops that snapshot the PDC wake configuration on suspend and
restore it on resume, gated on pm_suspend_via_firmware() so the s2idle
path (which keeps CX up) is unaffected.

Adapted from the OnePlus 11 (Android) kernel.

Signed-off-by: seilent <github@seilent.net>
---
--- a/drivers/irqchip/qcom-pdc.c	2026-05-30 00:05:10.354691692 +0900
+++ b/drivers/irqchip/qcom-pdc.c	2026-05-30 00:13:17.070150948 +0900
@@ -17,6 +17,8 @@
 #include <linux/of_irq.h>
 #include <linux/soc/qcom/irq.h>
 #include <linux/spinlock.h>
+#include <linux/suspend.h>
+#include <linux/syscore_ops.h>
 #include <linux/slab.h>
 #include <linux/types.h>
 
@@ -54,6 +56,11 @@
 static unsigned int pdc_version;
 static bool pdc_x1e_quirk;
 
+#define PDC_ENABLE_BANKS	(PDC_MAX_GPIO_IRQS / 32)
+static u32 pdc_save_enable[PDC_ENABLE_BANKS];
+static u32 pdc_save_cfg[PDC_MAX_GPIO_IRQS];
+static bool pdc_in_fw_suspend;
+
 static void pdc_base_reg_write(void __iomem *base, int reg, u32 i, u32 val)
 {
 	writel_relaxed(val, base + reg + i * sizeof(u32));
@@ -309,6 +316,76 @@
 	.free		= irq_domain_free_irqs_common,
 };
 
+/*
+ * Deep (firmware-assisted) suspend collapses CX and wipes the PDC wake
+ * configuration. Snapshot it on suspend and restore on resume so wake
+ * interrupts keep working. Inert for s2idle (CX stays up).
+ */
+static int pdc_syscore_suspend(void *data)
+{
+	int i, last, max_pin, banks, pin;
+
+	if (!pm_suspend_via_firmware())
+		return 0;
+	pdc_in_fw_suspend = true;
+
+	last = pdc_region_cnt - 1;
+	if (last < 0)
+		return 0;
+	max_pin = pdc_region[last].pin_base + pdc_region[last].cnt;
+	if (max_pin > PDC_MAX_GPIO_IRQS)
+		max_pin = PDC_MAX_GPIO_IRQS;
+
+	for (pin = 0; pin < max_pin; pin++)
+		pdc_save_cfg[pin] = pdc_reg_read(IRQ_i_CFG, pin);
+
+	if (pdc_version < PDC_VERSION_3_2) {
+		banks = DIV_ROUND_UP(max_pin, 32);
+		for (i = 0; i < banks; i++)
+			pdc_save_enable[i] = pdc_reg_read(IRQ_ENABLE_BANK, i);
+	}
+
+	return 0;
+}
+
+static void pdc_syscore_resume(void *data)
+{
+	int i, last, max_pin, banks, pin;
+
+	if (!pdc_in_fw_suspend)
+		return;
+	pdc_in_fw_suspend = false;
+
+	last = pdc_region_cnt - 1;
+	if (last < 0)
+		return;
+	max_pin = pdc_region[last].pin_base + pdc_region[last].cnt;
+	if (max_pin > PDC_MAX_GPIO_IRQS)
+		max_pin = PDC_MAX_GPIO_IRQS;
+
+	for (pin = 0; pin < max_pin; pin++)
+		pdc_reg_write(IRQ_i_CFG, pin, pdc_save_cfg[pin]);
+
+	if (pdc_version < PDC_VERSION_3_2) {
+		banks = DIV_ROUND_UP(max_pin, 32);
+		for (i = 0; i < banks; i++) {
+			if (pdc_x1e_quirk)
+				pdc_x1e_irq_enable_write(i, pdc_save_enable[i]);
+			else
+				pdc_reg_write(IRQ_ENABLE_BANK, i, pdc_save_enable[i]);
+		}
+	}
+}
+
+static const struct syscore_ops pdc_syscore_ops = {
+	.suspend = pdc_syscore_suspend,
+	.resume = pdc_syscore_resume,
+};
+
+static struct syscore pdc_syscore = {
+	.ops = &pdc_syscore_ops,
+};
+
 static int pdc_setup_pin_mapping(struct device_node *np)
 {
 	int ret, n, i;
@@ -419,6 +496,8 @@
 
 	irq_domain_update_bus_token(pdc_domain, DOMAIN_BUS_WAKEUP);
 
+	register_syscore(&pdc_syscore);
+
 	return 0;
 
 fail:
